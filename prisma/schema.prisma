// GLEX – Global Export House
// PostgreSQL schema. Every model uses a UUID primary key, createdAt/updatedAt
// audit columns, and (where the record is user-facing content) a `deletedAt`
// soft-delete column so history is never destroyed by an admin action.

generator client {
  provider = "prisma-client-js"
}

// Prisma 7: the connection URL lives in `prisma.config.ts` (for the CLI) and in
// the `@prisma/adapter-pg` adapter in `src/lib/db.ts` (for the runtime client).
datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  SUPER_ADMIN
  ADMIN
  SALES_MANAGER
  SALES_OFFICER
  PROCUREMENT_MANAGER
  LOGISTICS_MANAGER
  CONTENT_EDITOR
  SUPPORT_AGENT
  APPROVED_SUPPLIER
  PENDING_SUPPLIER
  DISTRIBUTOR
  CLIENT_ORG_ADMIN
  CLIENT_TEAM_MEMBER
}

enum OrganizationType {
  CLIENT
  SUPPLIER
  DISTRIBUTOR
  INTERNAL
}

enum ClientType {
  CONTRACTOR
  DEVELOPER
  CONSULTANT
  DISTRIBUTOR
  RETAILER
  GOVERNMENT_ENTITY
  PROJECT_OWNER
  PROCUREMENT_COMPANY
  INDIVIDUAL_BUYER
  OTHER
}

enum SupplierStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CLARIFICATION_REQUIRED
  APPROVED
  CONDITIONALLY_APPROVED
  REJECTED
  SUSPENDED
  ARCHIVED
}

enum SupplierKind {
  SUPPLIER
  DISTRIBUTOR
  BOTH
}

enum RfqStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  CLARIFICATION_REQUIRED
  SUPPLIER_SOURCING
  QUOTATION_PREPARED
  QUOTATION_SENT
  CLIENT_REVIEWING
  ACCEPTED
  REJECTED
  EXPIRED
  CONVERTED_TO_ORDER
  CANCELLED
}

enum ShipmentStatus {
  BOOKING_CREATED
  AWAITING_COLLECTION
  COLLECTED
  AT_ORIGIN_WAREHOUSE
  EXPORT_DOCUMENTATION
  CUSTOMS_CLEARANCE
  AT_ORIGIN_PORT
  LOADED
  DEPARTED
  IN_TRANSIT
  TRANSSHIPMENT
  AT_DESTINATION_PORT
  IMPORT_CUSTOMS
  OUT_FOR_DELIVERY
  DELIVERED
  DELAYED
  EXCEPTION
  CANCELLED
}

enum ShipmentMode {
  OCEAN
  AIR
  ROAD
  RAIL
  MULTIMODAL
}

enum Incoterm {
  EXW
  FCA
  FOB
  CFR
  CIF
  CPT
  CIP
  DAP
  DPU
  DDP
}

enum UnitOfMeasure {
  PIECE
  BOX
  CARTON
  PACK
  PALLET
  KILOGRAM
  TON
  METER
  SQUARE_METER
  CUBIC_METER
  ROLL
  SET
  CONTAINER
}

enum ContentStatus {
  DRAFT
  REVIEW
  SCHEDULED
  PUBLISHED
  ARCHIVED
}

enum Locale {
  en
  ar
  de
  fr
  zh_CN
}

enum InquiryType {
  GENERAL
  QUOTE_REQUEST
  FREIGHT_QUOTE
  SUPPLIER_REGISTRATION
  CLIENT_SUPPORT
  SHIPMENT_SUPPORT
  PARTNERSHIP
  MEDIA
  CAREERS
  OTHER
}

enum InquiryStatus {
  NEW
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
  SPAM
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_ON_CLIENT
  RESOLVED
  CLOSED
}

enum TicketPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum DocumentType {
  COMMERCIAL_INVOICE
  PACKING_LIST
  CERTIFICATE_OF_ORIGIN
  BILL_OF_LADING
  AIR_WAYBILL
  INSURANCE_CERTIFICATE
  INSPECTION_CERTIFICATE
  CUSTOMS_DOCUMENTATION
  PRODUCT_CERTIFICATE
  DELIVERY_NOTE
  COMMERCIAL_REGISTRATION
  VAT_CERTIFICATE
  COMPANY_PROFILE
  PRODUCT_CATALOGUE
  QUALITY_CERTIFICATE
  FACTORY_CERTIFICATION
  AUTHORIZATION_LETTER
  DATASHEET
  QUOTATION
  OTHER
}

enum NotificationChannel {
  IN_APP
  EMAIL
  SMS
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

// ---------------------------------------------------------------------------
// Authentication & identity
// ---------------------------------------------------------------------------

model User {
  id               String    @id @default(uuid()) @db.Uuid
  email            String    @unique
  emailVerified    DateTime?
  passwordHash     String?
  name             String
  phone            String?
  image            String?
  role             UserRole  @default(CLIENT_TEAM_MEMBER)
  preferredLocale  Locale    @default(en)
  isActive         Boolean   @default(true)
  // Brute-force protection
  failedLoginCount Int       @default(0)
  lockedUntil      DateTime?
  lastLoginAt      DateTime?

  organizationId String?       @db.Uuid
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  accounts             Account[]
  sessions             Session[]
  memberships          OrganizationMember[]
  clientProfile        ClientProfile?
  savedProducts        SavedProduct[]
  rfqs                 RFQ[]                  @relation("RfqCreatedBy")
  assignedRfqs         RFQ[]                  @relation("RfqAssignee")
  rfqMessages          RFQMessage[]
  rfqActivities        RFQActivity[]
  notifications        Notification[]
  auditLogs            AuditLog[]
  chatConversations    ChatConversation[]
  supportTickets       SupportTicket[]        @relation("TicketRequester")
  assignedTickets      SupportTicket[]        @relation("TicketAssignee")
  supportMessages      SupportMessage[]
  newsArticles         NewsArticle[]
  addresses            Address[]
  shipmentSubs         ShipmentSubscription[]
  notificationPrefs    NotificationPreference[]
  consentRecords       ConsentRecord[]
  dataRequests         DataRequest[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([organizationId])
  @@index([role])
  @@index([deletedAt])
}

model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @db.Uuid
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique
  userId       String   @db.Uuid
  expires      DateTime
  ipAddress    String?
  userAgent    String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

/// Single-use tokens for email verification, password reset and team invites.
model SecurityToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  purpose   String // EMAIL_VERIFICATION | PASSWORD_RESET | TEAM_INVITE
  email     String
  payload   Json?
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([email, purpose])
  @@index([expiresAt])
}

// ---------------------------------------------------------------------------
// Organizations
// ---------------------------------------------------------------------------

model Organization {
  id          String           @id @default(uuid()) @db.Uuid
  name        String
  slug        String           @unique
  type        OrganizationType
  country     String?
  city        String?
  address     String?
  website     String?
  phone       String?
  vatNumber   String?
  crNumber    String?
  description String?          @db.Text
  logoUrl     String?
  isActive    Boolean          @default(true)

  users           User[]
  members         OrganizationMember[]
  clientProfile   ClientProfile?
  supplierProfile SupplierProfile?
  rfqs            RFQ[]
  shipments       Shipment[]
  addresses       Address[]
  documents       StoredFile[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([type])
  @@index([deletedAt])
}

model OrganizationMember {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @db.Uuid
  userId         String   @db.Uuid
  role           UserRole
  isOwner        Boolean  @default(false)
  invitedAt      DateTime @default(now())
  acceptedAt     DateTime?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, userId])
  @@index([userId])
}

model ClientProfile {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String?    @unique @db.Uuid
  organizationId String?    @unique @db.Uuid
  clientType     ClientType
  companyName    String
  position       String?
  industry       String?
  country        String
  city           String?
  address        String?
  projectInterests String?  @db.Text
  procurementCategories String[] @default([])

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientType])
  @@index([country])
}

// ---------------------------------------------------------------------------
// Suppliers
// ---------------------------------------------------------------------------

model SupplierProfile {
  id             String         @id @default(uuid()) @db.Uuid
  organizationId String         @unique @db.Uuid
  status         SupplierStatus @default(DRAFT)
  kind           SupplierKind   @default(SUPPLIER)

  legalName    String
  tradingName  String?
  companyType  String?
  country      String
  city         String?
  address      String?
  website      String?
  crNumber     String?
  vatNumber    String?
  yearEstablished Int?
  employeeCount   String?
  description     String? @db.Text

  // Capabilities
  brands              String[] @default([])
  isManufacturer      Boolean  @default(false)
  isDistributor       Boolean  @default(false)
  monthlyCapacity     String?
  minimumOrderNotes   String?
  exportExperience    String?
  marketsServed       String[] @default([])
  availableIncoterms  Incoterm[] @default([])
  leadTimeNotes       String?
  qualityControlNotes String?  @db.Text

  // Workflow
  completionPercent Int       @default(0)
  internalNotes     String?   @db.Text
  clarificationNote String?   @db.Text
  reviewedAt        DateTime?
  reviewedById      String?   @db.Uuid
  submittedAt       DateTime?
  declarationAccepted Boolean @default(false)
  declarationAt     DateTime?

  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  documents       SupplierDocument[]
  certifications  SupplierCertification[]
  categories      SupplierProductCategory[]
  contacts        SupplierContact[]
  products        Product[]
  opportunities   SourcingOpportunity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([country])
}

model SupplierDocument {
  id         String       @id @default(uuid()) @db.Uuid
  supplierId String       @db.Uuid
  type       DocumentType
  fileId     String       @db.Uuid
  label      String?
  expiresAt  DateTime?
  verified   Boolean      @default(false)

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  file     StoredFile      @relation(fields: [fileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId, type])
}

model SupplierCertification {
  id          String    @id @default(uuid()) @db.Uuid
  supplierId  String    @db.Uuid
  name        String
  issuer      String?
  reference   String?
  issuedAt    DateTime?
  expiresAt   DateTime?
  fileId      String?   @db.Uuid

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  file     StoredFile?     @relation(fields: [fileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId])
}

model SupplierProductCategory {
  id         String @id @default(uuid()) @db.Uuid
  supplierId String @db.Uuid
  categoryId String @db.Uuid

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  category Category        @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([supplierId, categoryId])
  @@index([categoryId])
}

model SupplierContact {
  id         String  @id @default(uuid()) @db.Uuid
  supplierId String  @db.Uuid
  kind       String // SALES | EXPORT | TECHNICAL | LOGISTICS
  name       String
  email      String
  phone      String?
  position   String?

  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([supplierId, kind])
}

// ---------------------------------------------------------------------------
// Catalogue
// ---------------------------------------------------------------------------

model Category {
  id          String  @id @default(uuid()) @db.Uuid
  slug        String  @unique
  name        String
  description String? @db.Text
  icon        String?
  imageUrl    String?
  parentId    String? @db.Uuid
  sortOrder   Int     @default(0)
  isActive    Boolean @default(true)

  parent       Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children     Category[] @relation("CategoryTree")
  products     Product[]
  translations CategoryTranslation[]
  suppliers    SupplierProductCategory[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([parentId])
  @@index([isActive])
}

model CategoryTranslation {
  id          String @id @default(uuid()) @db.Uuid
  categoryId  String @db.Uuid
  locale      Locale
  name        String
  description String? @db.Text

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model Product {
  id               String  @id @default(uuid()) @db.Uuid
  slug             String  @unique
  name             String
  shortDescription String? @db.Text
  description      String? @db.Text
  specifications   Json? // [{ key, value, unit }]
  brand            String?
  manufacturer     String?
  countryOfOrigin  String?
  isSaudiMade      Boolean @default(false)
  hsCode           String?
  minimumOrderQty  Int?
  packaging        String?
  leadTimeDays     Int?
  certifications   String[] @default([])
  availableUnits   UnitOfMeasure[] @default([])
  allowEquivalents Boolean @default(true)
  isVisible        Boolean @default(true)
  isFeatured       Boolean @default(false)
  viewCount        Int     @default(0)

  categoryId String  @db.Uuid
  supplierId String? @db.Uuid

  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  supplier     SupplierProfile?  @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  images       ProductImage[]
  documents    ProductDocument[]
  translations ProductTranslation[]
  savedBy      SavedProduct[]
  rfqItems     RFQItem[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([categoryId])
  @@index([supplierId])
  @@index([isVisible, isFeatured])
  @@index([brand])
  @@index([countryOfOrigin])
  @@index([isSaudiMade])
  @@index([deletedAt])
}

model ProductTranslation {
  id               String  @id @default(uuid()) @db.Uuid
  productId        String  @db.Uuid
  locale           Locale
  name             String
  shortDescription String? @db.Text
  description      String? @db.Text

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, locale])
}

model ProductImage {
  id        String  @id @default(uuid()) @db.Uuid
  productId String  @db.Uuid
  url       String
  alt       String?
  sortOrder Int     @default(0)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model ProductDocument {
  id        String       @id @default(uuid()) @db.Uuid
  productId String       @db.Uuid
  type      DocumentType
  fileId    String       @db.Uuid
  label     String?

  product Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  file    StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model SavedProduct {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  productId String @db.Uuid
  note      String?

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// RFQ workflow
// ---------------------------------------------------------------------------

model RFQ {
  id        String    @id @default(uuid()) @db.Uuid
  reference String    @unique // GLEX-RFQ-2026-000001
  status    RfqStatus @default(DRAFT)

  // Guest RFQs are permitted but must verify their email before submission.
  isGuest       Boolean   @default(false)
  guestEmail    String?
  guestName     String?
  guestCompany  String?
  guestPhone    String?
  emailVerified Boolean   @default(false)

  createdById    String? @db.Uuid
  organizationId String? @db.Uuid
  assigneeId     String? @db.Uuid

  // Commercial requirements
  destinationCountry String
  destinationCity    String?
  destinationPort    String?
  incoterm           Incoterm?
  requiredDeliveryDate DateTime?
  preferredBrands    String?
  allowEquivalents   Boolean  @default(true)
  projectName        String?
  projectDetails     String?  @db.Text
  notes              String?  @db.Text
  locale             Locale   @default(en)

  submittedAt DateTime?
  expiresAt   DateTime?

  createdBy    User?         @relation("RfqCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  assignee     User?         @relation("RfqAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  items         RFQItem[]
  attachments   RFQAttachment[]
  messages      RFQMessage[]
  activities    RFQActivity[]
  quotations    Quotation[]
  shipments     Shipment[]
  opportunities SourcingOpportunity[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([organizationId])
  @@index([createdById])
  @@index([assigneeId])
  @@index([createdAt])
}

model RFQItem {
  id        String        @id @default(uuid()) @db.Uuid
  rfqId     String        @db.Uuid
  productId String?       @db.Uuid
  // Free-text line items are allowed for products not yet in the catalogue.
  name      String
  quantity  Decimal       @db.Decimal(14, 3)
  unit      UnitOfMeasure
  brand     String?
  specification String?   @db.Text
  notes     String?       @db.Text
  sortOrder Int           @default(0)

  rfq     RFQ      @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rfqId])
  @@index([productId])
}

model RFQAttachment {
  id     String @id @default(uuid()) @db.Uuid
  rfqId  String @db.Uuid
  fileId String @db.Uuid
  label  String?

  rfq  RFQ        @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  file StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([rfqId])
}

model RFQMessage {
  id         String  @id @default(uuid()) @db.Uuid
  rfqId      String  @db.Uuid
  authorId   String? @db.Uuid
  body       String  @db.Text
  /// Internal notes are visible to GLEX staff only, never to the client.
  isInternal Boolean @default(false)

  rfq    RFQ   @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  author User? @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([rfqId, createdAt])
}

model RFQActivity {
  id        String     @id @default(uuid()) @db.Uuid
  rfqId     String     @db.Uuid
  actorId   String?    @db.Uuid
  action    String
  fromStatus RfqStatus?
  toStatus   RfqStatus?
  metadata  Json?

  rfq   RFQ   @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([rfqId, createdAt])
}

model Quotation {
  id          String    @id @default(uuid()) @db.Uuid
  rfqId       String    @db.Uuid
  reference   String    @unique
  version     Int       @default(1)
  fileId      String?   @db.Uuid
  currency    String    @default("SAR")
  notes       String?   @db.Text
  validUntil  DateTime?
  sentAt      DateTime?
  acceptedAt  DateTime?
  rejectedAt  DateTime?
  rejectionReason String? @db.Text

  rfq  RFQ         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  file StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([rfqId])
}

/// A sourcing request routed from an RFQ to a specific approved supplier.
/// Suppliers may only ever see the opportunities assigned to them.
model SourcingOpportunity {
  id         String    @id @default(uuid()) @db.Uuid
  rfqId      String    @db.Uuid
  supplierId String    @db.Uuid
  status     String    @default("ASSIGNED") // ASSIGNED | RESPONDED | DECLINED | CLOSED
  message    String?   @db.Text
  response   String?   @db.Text
  respondedAt DateTime?
  dueAt      DateTime?

  rfq      RFQ             @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier SupplierProfile @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([rfqId, supplierId])
  @@index([supplierId, status])
}

// ---------------------------------------------------------------------------
// Shipments & tracking
// ---------------------------------------------------------------------------

model Shipment {
  id        String         @id @default(uuid()) @db.Uuid
  reference String         @unique // GLEX-SHP-2026-000001
  status    ShipmentStatus @default(BOOKING_CREATED)
  mode      ShipmentMode

  organizationId String? @db.Uuid
  rfqId          String? @db.Uuid

  originCountry      String
  originCity         String?
  originPort         String?
  destinationCountry String
  destinationCity    String?
  destinationPort    String?

  carrier          String?
  containerNumber  String?
  billOfLading     String?
  carrierTrackingNumber String?

  estimatedDeparture DateTime?
  actualDeparture    DateTime?
  estimatedArrival   DateTime?
  actualArrival      DateTime?

  progressPercent Int       @default(0)
  exceptionNote   String?   @db.Text

  /// Which TrackingProvider produced the latest data, and when it last synced.
  provider       String    @default("internal")
  lastSyncedAt   DateTime?
  providerError  String?

  /// Seeded demonstration records are flagged so the UI can label them clearly
  /// and production can exclude them.
  isDemo Boolean @default(false)

  organization  Organization?          @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  rfq           RFQ?                   @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  events        ShipmentEvent[]
  documents     ShipmentDocument[]
  subscriptions ShipmentSubscription[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([organizationId])
  @@index([containerNumber])
  @@index([billOfLading])
  @@index([carrierTrackingNumber])
}

model ShipmentEvent {
  id         String         @id @default(uuid()) @db.Uuid
  shipmentId String         @db.Uuid
  status     ShipmentStatus
  title      String
  description String?       @db.Text
  location   String?
  occurredAt DateTime
  source     String         @default("manual") // manual | provider:<name> | webhook
  /// Stable hash of the provider payload — prevents duplicate event ingestion.
  dedupeKey  String?
  isException Boolean       @default(false)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([shipmentId, dedupeKey])
  @@index([shipmentId, occurredAt])
}

model ShipmentDocument {
  id         String       @id @default(uuid()) @db.Uuid
  shipmentId String       @db.Uuid
  type       DocumentType
  fileId     String       @db.Uuid
  label      String?
  /// Documents are private to the owning organization unless explicitly shared.
  isClientVisible Boolean @default(true)

  shipment Shipment   @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  file     StoredFile @relation(fields: [fileId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([shipmentId, type])
}

model ShipmentSubscription {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @db.Uuid
  userId     String?  @db.Uuid
  email      String
  channels   NotificationChannel[] @default([EMAIL])
  isActive   Boolean  @default(true)

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  user     User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([shipmentId, email])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Addresses & files
// ---------------------------------------------------------------------------

model Address {
  id             String  @id @default(uuid()) @db.Uuid
  userId         String? @db.Uuid
  organizationId String? @db.Uuid
  kind           String // BILLING | DELIVERY | PORT | WAREHOUSE
  label          String
  contactName    String?
  phone          String?
  line1          String
  line2          String?
  city           String?
  state          String?
  postalCode     String?
  country        String
  isDefault      Boolean @default(false)

  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind])
  @@index([organizationId, kind])
}

/// Every upload in the system. Storage is abstracted (local disk in dev,
/// S3-compatible in production) — `key` is provider-relative, never a raw URL.
model StoredFile {
  id           String  @id @default(uuid()) @db.Uuid
  key          String  @unique
  originalName String
  mimeType     String
  size         Int
  checksum     String?
  provider     String  @default("local")
  /// Set once a malware scanner has cleared the file. Null = not yet scanned.
  scannedAt    DateTime?
  scanResult   String?

  uploadedById   String? @db.Uuid
  organizationId String? @db.Uuid

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  supplierDocuments SupplierDocument[]
  certifications    SupplierCertification[]
  productDocuments  ProductDocument[]
  rfqAttachments    RFQAttachment[]
  quotations        Quotation[]
  shipmentDocuments ShipmentDocument[]
  inquiries         ContactInquiry[]

  createdAt DateTime  @default(now())
  deletedAt DateTime?

  @@index([organizationId])
  @@index([uploadedById])
}

// ---------------------------------------------------------------------------
// News / CMS
// ---------------------------------------------------------------------------

model NewsCategory {
  id       String  @id @default(uuid()) @db.Uuid
  slug     String  @unique
  name     String
  sortOrder Int    @default(0)

  articles     NewsArticle[]
  translations NewsCategoryTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NewsCategoryTranslation {
  id         String @id @default(uuid()) @db.Uuid
  categoryId String @db.Uuid
  locale     Locale
  name       String

  category NewsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
}

model NewsArticle {
  id          String        @id @default(uuid()) @db.Uuid
  slug        String        @unique
  title       String
  summary     String        @db.Text
  body        String        @db.Text
  featuredImage String?
  gallery     String[]      @default([])
  status      ContentStatus @default(DRAFT)
  isFeatured  Boolean       @default(false)
  publishedAt DateTime?
  readingMinutes Int        @default(1)
  viewCount   Int           @default(0)

  seoTitle       String?
  seoDescription String? @db.Text
  socialImage    String?

  /// Seeded sample articles are flagged so they can be filtered or removed.
  isSample Boolean @default(false)

  categoryId String? @db.Uuid
  authorId   String? @db.Uuid

  category     NewsCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author       User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  translations NewsTranslation[]
  tags         NewsArticleTag[]

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([deletedAt])
}

model NewsTranslation {
  id        String @id @default(uuid()) @db.Uuid
  articleId String @db.Uuid
  locale    Locale
  title     String
  summary   String @db.Text
  body      String @db.Text
  seoTitle       String?
  seoDescription String? @db.Text

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
}

model NewsTag {
  id   String @id @default(uuid()) @db.Uuid
  slug String @unique
  name String

  articles NewsArticleTag[]

  createdAt DateTime @default(now())
}

model NewsArticleTag {
  articleId String @db.Uuid
  tagId     String @db.Uuid

  article NewsArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)
  tag     NewsTag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([articleId, tagId])
  @@index([tagId])
}

// ---------------------------------------------------------------------------
// Contact, support, notifications
// ---------------------------------------------------------------------------

model ContactInquiry {
  id        String        @id @default(uuid()) @db.Uuid
  reference String        @unique // GLEX-INQ-2026-000001
  type      InquiryType
  status    InquiryStatus @default(NEW)

  fullName String
  company  String?
  email    String
  phone    String?
  country  String?
  subject  String
  message  String  @db.Text
  locale   Locale  @default(en)

  fileId       String? @db.Uuid
  assigneeId   String? @db.Uuid
  internalNotes String? @db.Text

  consentGiven Boolean  @default(false)
  ipAddress    String?
  userAgent    String?

  file StoredFile? @relation(fields: [fileId], references: [id], onDelete: SetNull)
  /// Present only for FREIGHT_QUOTE enquiries.
  freight FreightInquiry?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model SupportTicket {
  id        String         @id @default(uuid()) @db.Uuid
  reference String         @unique // GLEX-TKT-2026-000001
  subject   String
  status    TicketStatus   @default(OPEN)
  priority  TicketPriority @default(NORMAL)

  requesterId String  @db.Uuid
  assigneeId  String? @db.Uuid

  requester User             @relation("TicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  assignee  User?            @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  messages  SupportMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([requesterId])
  @@index([status])
}

model SupportMessage {
  id         String  @id @default(uuid()) @db.Uuid
  ticketId   String  @db.Uuid
  authorId   String? @db.Uuid
  body       String  @db.Text
  isInternal Boolean @default(false)

  ticket SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model Notification {
  id      String  @id @default(uuid()) @db.Uuid
  userId  String  @db.Uuid
  type    String
  title   String
  body    String? @db.Text
  href    String?
  readAt  DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id      String              @id @default(uuid()) @db.Uuid
  userId  String              @db.Uuid
  topic   String // RFQ_UPDATES | SHIPMENT_UPDATES | NEWS | MARKETING
  channel NotificationChannel
  enabled Boolean             @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, topic, channel])
}

// ---------------------------------------------------------------------------
// Chatbot
// ---------------------------------------------------------------------------

model ChatConversation {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String? @db.Uuid
  /// Anonymous visitors are tracked by an opaque cookie id, never by IP alone.
  visitorId String?
  locale    Locale  @default(en)
  title     String?
  /// Set when the conversation is escalated to a human agent.
  handoffAt DateTime?
  feedback  Int? // -1 | 1

  user     User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages ChatMessage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([visitorId])
}

model ChatMessage {
  id             String   @id @default(uuid()) @db.Uuid
  conversationId String   @db.Uuid
  role           ChatRole
  content        String   @db.Text
  /// Names of tools invoked for this turn — arguments are deliberately not
  /// persisted so private lookups never leak into the transcript store.
  toolsUsed      String[] @default([])

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

model KnowledgeDocument {
  id       String  @id @default(uuid()) @db.Uuid
  slug     String  @unique
  title    String
  body     String  @db.Text
  locale   Locale  @default(en)
  category String?
  isActive Boolean @default(true)
  /// Only admin-approved documents are ever surfaced to the assistant.
  approvedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locale, isActive])
}

model FaqEntry {
  id        String  @id @default(uuid()) @db.Uuid
  question  String
  answer    String  @db.Text
  locale    Locale  @default(en)
  category  String?
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([locale, isActive])
}

// ---------------------------------------------------------------------------
// Site configuration & governance
// ---------------------------------------------------------------------------

model AuditLog {
  id         String  @id @default(uuid()) @db.Uuid
  actorId    String? @db.Uuid
  action     String
  entityType String
  entityId   String?
  /// Before/after snapshots with sensitive fields already masked at write time.
  changes    Json?
  ipAddress  String?
  userAgent  String?

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([actorId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model Announcement {
  id        String    @id @default(uuid()) @db.Uuid
  message   String
  href      String?
  variant   String    @default("info") // info | warning | success
  isActive  Boolean   @default(false)
  startsAt  DateTime?
  endsAt    DateTime?

  translations AnnouncementTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model AnnouncementTranslation {
  id             String @id @default(uuid()) @db.Uuid
  announcementId String @db.Uuid
  locale         Locale
  message        String

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, locale])
}

model SocialLink {
  id        String  @id @default(uuid()) @db.Uuid
  platform  String
  url       String
  sortOrder Int     @default(0)
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Office {
  id        String  @id @default(uuid()) @db.Uuid
  name      String
  addressLines String[] @default([])
  city      String
  country   String
  poBox     String?
  postalCode String?
  phone     String?
  latitude  Float?
  longitude Float?
  businessHours Json? // [{ day, open, close }]
  isPrimary Boolean @default(false)

  translations OfficeTranslation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OfficeTranslation {
  id       String @id @default(uuid()) @db.Uuid
  officeId String @db.Uuid
  locale   Locale
  name     String
  addressLines String[] @default([])

  office Office @relation(fields: [officeId], references: [id], onDelete: Cascade)

  @@unique([officeId, locale])
}

/// Editable trade lanes rendered on the animated homepage map.
model GlobalRoute {
  id        String  @id @default(uuid()) @db.Uuid
  label     String
  originName String
  originLat  Float
  originLng  Float
  destName   String
  destLat    Float
  destLng    Float
  mode       ShipmentMode @default(OCEAN)
  sortOrder  Int     @default(0)
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model SiteSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model EmailTemplate {
  id        String  @id @default(uuid()) @db.Uuid
  key       String
  locale    Locale
  subject   String
  heading   String?
  body      String  @db.Text
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([key, locale])
}

/// Cookie/marketing consent, retained as evidence for privacy compliance.
model ConsentRecord {
  id        String  @id @default(uuid()) @db.Uuid
  userId    String? @db.Uuid
  visitorId String?
  purpose   String // ANALYTICS | MARKETING | CONTACT_FORM
  granted   Boolean
  ipAddress String?
  userAgent String?

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([visitorId])
}

/// GDPR-style data export / account deletion requests.
model DataRequest {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @db.Uuid
  kind      String // EXPORT | DELETION
  status    String    @default("PENDING") // PENDING | PROCESSING | COMPLETED | REJECTED
  notes     String?   @db.Text
  handledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, kind])
  @@index([status])
}

/// Persistent counters backing the human-readable reference generators
/// (GLEX-RFQ-2026-000001). Incremented inside a transaction.
model ReferenceCounter {
  id     String @id @default(uuid()) @db.Uuid
  scope  String // RFQ | SHP | INQ | TKT | QUO
  year   Int
  value  Int    @default(0)

  @@unique([scope, year])
}

/// Durable rate-limit buckets. Keyed by e.g. "contact:203.0.113.4".
model RateLimit {
  key       String   @id
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}

/// Structured detail for a freight-quote enquiry.
///
/// Kept in its own table rather than as a dozen nullable columns on
/// `ContactInquiry`, which would be null for every other enquiry type. The
/// submission itself reuses the contact pipeline — reference, consent record,
/// rate limiting and notifications — so only the freight-specific fields live
/// here.
///
/// There is deliberately no price or rate field. GLEX quotes freight in a
/// written offer, exactly as it quotes goods.
model FreightInquiry {
  id        String @id @default(uuid()) @db.Uuid
  inquiryId String @unique @db.Uuid

  mode     ShipmentMode
  incoterm Incoterm?

  originCountry      String
  originCity         String?
  originPort         String?
  destinationCountry String
  destinationCity    String?
  destinationPort    String?

  cargoDescription String  @db.Text
  /// Gross weight in kilograms.
  weightKg         Decimal? @db.Decimal(12, 2)
  /// Total volume in cubic metres.
  volumeCbm        Decimal? @db.Decimal(12, 2)
  /// Free text, e.g. "2 x 40ft HC". Carriers name these inconsistently.
  containerType    String?
  /// Dangerous goods change what may be carried, and how. Declared, never inferred.
  isHazardous      Boolean  @default(false)
  /// When the cargo is available for collection.
  readyDate        DateTime?

  inquiry ContactInquiry @relation(fields: [inquiryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
