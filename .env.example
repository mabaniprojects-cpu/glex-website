# =============================================================================
# GLEX – Global Export House :: environment configuration
# Copy to `.env` and fill in. NEVER commit `.env`.
# Values are validated at startup by src/lib/env.ts — the app refuses to boot
# with an invalid configuration rather than failing later at runtime.
# =============================================================================

# --- Core -------------------------------------------------------------------
# PostgreSQL connection string.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/glex?schema=public"

# Auth.js v5. Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_NAME="GLEX – Global Export House"

# Where contact-form submissions and internal notifications are delivered.
CONTACT_TO_EMAIL=""

# --- Email ------------------------------------------------------------------
# EMAIL_PROVIDER: smtp | resend | console
# `console` (the default in development) prints emails to the terminal and
# sends nothing, so the app is fully usable with no mail credentials.
EMAIL_PROVIDER="console"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="GLEX <noreply@example.com>"

RESEND_API_KEY=""

# --- File storage -----------------------------------------------------------
# STORAGE_PROVIDER: local | s3
# `local` writes to ./storage (gitignored) and is intended for development.
STORAGE_PROVIDER="local"

S3_ENDPOINT=""
S3_REGION=""
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Set true for MinIO / non-AWS S3-compatible endpoints.
S3_FORCE_PATH_STYLE="false"

# Maximum upload size in megabytes.
UPLOAD_MAX_MB="15"

# --- AI chatbot -------------------------------------------------------------
# Optional. With no key the assistant falls back to deterministic FAQ search,
# and the application still builds and runs normally.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5"

# Assistant messages allowed per 15 minutes, per account or per IP.
# Raise it where many genuine visitors share one address (corporate NAT).
CHAT_RATE_LIMIT="30"

# --- Shipment tracking ------------------------------------------------------
# TRACKING_PROVIDER: internal | mock | <external adapter name>
# `internal` = GLEX logistics staff maintain events by hand (production-safe).
# `mock`     = seeded demonstration data, clearly labelled "Demo Tracking Mode".
# External adapters stay disabled until valid credentials are supplied.
TRACKING_PROVIDER="internal"
TRACKING_API_KEY=""
TRACKING_WEBHOOK_SECRET=""

# --- Maps -------------------------------------------------------------------
# Any MapLibre-compatible style URL. Leave empty to render the built-in
# lightweight SVG world map instead of loading a remote tile provider.
MAP_STYLE_URL=""

# --- Bot protection ---------------------------------------------------------
# Cloudflare Turnstile. When unset, public forms fall back to rate limiting
# plus a honeypot field.
TURNSTILE_SITE_KEY=""
TURNSTILE_SECRET_KEY=""
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# --- Analytics --------------------------------------------------------------
# Privacy-conscious and opt-in. No third-party tracker loads before consent.
ANALYTICS_PROVIDER="none"

# --- Error monitoring (Sentry) ----------------------------------------------
# Optional. With no DSN nothing is initialised and nothing is sent anywhere.
#
# SENTRY_DSN covers the server: rendering, Server Actions and route handlers.
# It reports faults in GLEX's own software and carries no visitor data.
#
# NEXT_PUBLIC_SENTRY_DSN covers the browser, and is gated on cookie consent —
# a visitor who has not chosen, or who chose essential only, sends nothing.
# Usually the same DSN in both.
SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_DSN=""

# Defaults to NODE_ENV. Set to distinguish staging from production.
SENTRY_ENVIRONMENT=""

# Performance tracing, 0 to 1. Off by default: tracing samples every request,
# not just failures, which is a different order of cost from error reporting.
SENTRY_TRACES_SAMPLE_RATE="0"

# Build-time source-map upload, so production stack traces name real functions
# instead of minified ones. All three are required or the step is skipped
# entirely; the build succeeds either way. SENTRY_AUTH_TOKEN is a secret.
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""

# --- Seeding ----------------------------------------------------------------
# Demo accounts are created ONLY when this is "true" AND NODE_ENV !== production.
SEED_DEMO_DATA="true"

# Required when SEED_DEMO_DATA is "true" — seeding refuses to run without it.
# Left empty deliberately: a value here would be copied into every .env and
# become the same password for admin@glex.demo everywhere, which is the problem
# a default was removed to solve. Choose your own, 10+ characters with a letter
# and a digit.
SEED_DEMO_PASSWORD=""
