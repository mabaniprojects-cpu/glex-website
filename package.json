{
  "name": "glex-app",
  "version": "0.1.0",
  "private": true,
  "description": "GLEX – Global Export House: corporate website and digital logistics platform.",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "brand:assets": "node scripts/build-brand-assets.mjs",
    "postinstall": "prisma generate",
    "package:standalone": "node scripts/package-standalone.mjs",
    "start:standalone": "node .next/standalone/server.js"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.23",
